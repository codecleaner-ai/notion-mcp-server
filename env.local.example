############################################
#
## Server environment variables
## Use when building Docker Image
#
############################################
# Set the port to 3002 for local development.
# For deployment to GCP Cloud Run the port MUST be `8080`
# The code will omit the port if not specified
PORT=3002

# Transport protocol
# either `http` or `stdio`
TRANSPORT=http

# Multi-tenant setup
# Can be either `true` or `false`
# Default to `false`
MULTI_TENANT=true

############################################
#
## Server environment variables
## Use when Starting the Cloud Run Container
#
############################################

# Generate verbose logs
DEBUG_MODE=true

# Authorization token to access the MCP server
# Will be auto-generated if NOT provided.
# Must be incluyded in teh header
# headers: {
#    "Authorization": `Bearer ${AUTH_TOKEN}`,  // ← Required!
#    "Content-Type": "application/json"
#  }
# When calling the MCP server
AUTH_TOKEN="<super-secret-token-to-grant-access-to-the-mcp-server>"

############################################
#
## variable ONLY USED for tests 
#  While developping LOCALLY
# We do NOT need these variable when
#  - Building the Docker Image
#  - Running the Cloud Run Container
#
############################################

# Notion Token
# Only valid for Single tenant setup
# MUST be provided if MULTI_TENANT variable is set to `false`
NOTION_TOKEN="<super-secret-ntn_***-token-to-grant-access-to-ONE-workspace-only"

# For multi-tenant testing: 
NOTION_TOKEN_1=ntn-****
NOTION_TOKEN_2=ntn-****