# Exclude node_modules (will be installed during Docker build)
node_modules/

# Exclude build artifacts
build/
dist/
bin/

# Exclude cache files
.cache
.eslintcache
.yarn/cache

# Exclude IDE files
.cursor
.DS_Store

# Exclude environment files
.env
.env.local

# Exclude log files
logs/
*.log

# Exclude tests and documentation if not needed for build
tests/
docs/

# Exclude Docker-related files
Dockerfile
docker-compose.yml
.dockerignore

# Exclude Cloud Build configuration (not needed in Docker image)
cloudbuild.yaml
.gcloudignore

# Exclude git files
.git/
.gitignore

# Exclude temporary files
*.tmp
.tmp
tmp/

# Exclude package manager files (package-lock.json is needed, but we can exclude others)
.tgz
.tar.gz